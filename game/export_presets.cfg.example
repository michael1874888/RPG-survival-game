[preset.0]
name="Android"
platform="Android"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter="assets/fonts/OFL.txt,assets/fonts/SOURCE.md,data/x1/*.json"
exclude_filter="tests/*,tools/*"
export_path="../builds/android/bramble-v0.31.1-debug.apk"
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]
custom_template/debug=""
custom_template/release=""
gradle_build/use_gradle_build=false
gradle_build/export_format=0
architectures/armeabi-v7a=false
architectures/arm64-v8a=true
architectures/x86=false
architectures/x86_64=false
version/code=32
version/name="0.31.1"
package/unique_name="org.bramble.prototype"
package/name="Bramble"
package/signed=true
screen/immersive_mode=true
permissions/internet=false
permissions/vibrate=true
